:80 {
    # route executes directives strictly in the order written
    route /demo/* {
        uri strip_prefix /demo
        root * /etc/demo
        file_server
    }

    route /api/* {
        request_body {
            max_size 100MB
        }

        reverse_proxy stemsplitter-api:8000 {
            header_up X-Real-IP {remote_host}

            transport http {
                response_header_timeout 300s
            }
        }
    }
}